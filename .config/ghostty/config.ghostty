command = direct:/opt/homebrew/bin/zsh
theme = light:Monokai Pro Light Custom,dark:Monokai Pro Custom
window-theme = system
font-family = Ubuntu Mono
font-size = 15
adjust-cell-width = 1
cursor-style = block
# ssh-env: use xterm-256color on remote hosts that lack xterm-ghostty terminfo
shell-integration-features = no-cursor,ssh-env
copy-on-select = clipboard

# Undo / Redo
keybind = super+z=text:\x1f
keybind = super+shift+z=text:\x18\x1fu
