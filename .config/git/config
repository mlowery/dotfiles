[alias]
    # View the current working tree status using the short format
    s = status -s
    remotes = remote -v
    ls = log --pretty=format:"%C(yellow)%h\\ %C(cyan)%ad%C(red\\ bold)%d\\ %Creset%s%C(blue\\ bold)\\ [%cn]"
    ll = log --pretty=format:"%C(yellow)%h\\ %C(cyan)%ad%C(red\\ bold)%d\\ %Creset%s%C(blue\\ bold)\\ [%cn]" --name-status

[push]
    autoSetupRemote = true
    # push annotated tags reachable from the pushed commits
    followTags = true

[pull]
    rebase = merges

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[fetch]
    # delete local refs to branches removed on the remote
    prune = true

[merge]
    # Include summaries of merged commits in newly created merge commit messages
    log = true
    conflictstyle = zdiff3

[commit]
    verbose = true

[diff]
    algorithm = histogram
    colorMoved = default

[init]
    defaultBranch = main

[rebase]
    autosquash = true
    autostash = true
    # move branches stacked on the rebased one along with it
    updateRefs = true

[rerere]
    enabled = true
    # stage resolutions that rerere reapplies
    autoupdate = true

[branch]
    sort = -committerdate

[tag]
    # v1.10 after v1.9
    sort = version:refname

[help]
    # offer to run the command you meant on a typo
    autocorrect = prompt

[transfer]
    fsckobjects = true

[include]
    path = ~/.gitconfig_extra
