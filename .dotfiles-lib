_dot_is_osx() {
    [[ $OSTYPE == darwin* ]]
}

_dot_on_path() {
    (( $+commands[${1?cmd is required}] ))
}

_dot_prepend_to_path() {
    local dir="${1?dir is required}"
    if [[ -d $dir ]]; then
        # assign the array, not $PATH, so typeset -U path drops duplicates
        path=("$dir" $path)
    fi
}
