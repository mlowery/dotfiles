if _dot_is_osx; then
    if _dot_on_path brew; then
        # Install anything missing from the Brewfile, then upgrade all
        # installed formulae (not just those in the Brewfile). brew updates
        # itself first and cleans up old versions afterward.
        brew bundle install --no-upgrade --file=Brewfile
        brew upgrade

        # compinit rejects group-writable completion dirs (per the
        # zsh-completions caveat)
        chmod go-w "$(brew --prefix)/share"
    else
        echo "WARNING: HomeBrew not installed"
    fi
fi
