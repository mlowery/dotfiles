#!/bin/sh
# Block a push if the outgoing commits contain secrets or private strings
# (gitleaks, configured by .gitleaks.toml), or were authored or committed
# with an email other than user.email. install.sh enables this hook with
# `git config core.hooksPath .githooks`.
set -eu

expected=$(git config user.email) || {
    echo "pre-push: user.email is not set" >&2
    exit 1
}
command -v gitleaks >/dev/null || {
    echo "pre-push: gitleaks not found (brew install gitleaks)" >&2
    exit 1
}

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # deleting a remote branch: nothing to check
    case $local_sha in *[!0]*) ;; *) continue ;; esac
    # new remote branch: check commits that aren't on any remote yet
    case $remote_sha in
        *[!0]*) range="$remote_sha..$local_sha" ;;
        *) range="$local_sha --not --remotes" ;;
    esac

    bad=$(git log --format='%h %ae %ce' $range | awk -v e="$expected" '$2 != e || $3 != e')
    if [ -n "$bad" ]; then
        echo "pre-push: commits not authored and committed as $expected:" >&2
        echo "$bad" >&2
        status=1
    fi

    gitleaks git --no-banner --redact --log-opts="$range" . </dev/null >&2 || status=1
done

exit $status
