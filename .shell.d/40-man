# Don’t clear the screen after quitting a manual page
export MANPAGER="less -RIX"

# Colored man pages (from oh-my-zsh plugins/colored-man-pages)
function man() {
    LESS_TERMCAP_mb=$'\e[1;31m' LESS_TERMCAP_md=$'\e[1;31m' LESS_TERMCAP_me=$'\e[0m' \
    LESS_TERMCAP_so=$'\e[1;33;44m' LESS_TERMCAP_se=$'\e[0m' \
    LESS_TERMCAP_us=$'\e[1;32m' LESS_TERMCAP_ue=$'\e[0m' \
    GROFF_NO_SGR=1 command man "$@"
}
