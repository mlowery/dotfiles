# /etc/paths.d/homebrew adds /opt/homebrew/bin after the system dirs (via
# path_helper in login shells); put Homebrew first instead. This replaces
# `eval "$(brew shellenv)"`, which costs ~30ms per shell.
export HOMEBREW_PREFIX=/opt/homebrew
path=($HOMEBREW_PREFIX/bin $HOMEBREW_PREFIX/sbin $path)
fpath=($HOMEBREW_PREFIX/share/zsh/site-functions $fpath)

# GNU tools under their plain names (sed, grep, tar, ...)
# skip libtool: its gnubin shadows Apple's libtool, which Xcode builds need
for d in $HOMEBREW_PREFIX/opt/*/libexec/gnubin(N); do
    [[ $d == */libtool/* ]] || _dot_prepend_to_path $d
done
unset d
