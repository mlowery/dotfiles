# Remove a host's known_hosts entry. Defaults to the last word of the
# previous command, e.g. after `ssh user@host` fails on a changed key.
function rmkey() {
    local host="${1:-${${(z)$(fc -ln -1)}[-1]}}"
    ssh-keygen -R "${host#*@}"
}

e64() {
    : "${1?val is required}"
    for val in "$@"; do
        printf '%s' "$val" | base64 -w 0
        echo
    done
}

d64() {
    : "${1?val is required}"
    for val in "$@"; do
        printf '%s' "$val" | base64 -d
        echo
    done
}
