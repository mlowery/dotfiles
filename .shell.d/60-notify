if _dot_is_osx; then
    function notify {
        local msg="${1?msg is required}"
        local title="${2-}"
        local subtitle="${3-}"
        # pass values as arguments so quotes in them can't break the script
        osascript \
            -e 'on run argv' \
            -e 'display notification (item 1 of argv) with title (item 2 of argv) subtitle (item 3 of argv) sound name "Glass"' \
            -e 'end run' \
            "$msg" "$title" "$subtitle"
    }
fi
